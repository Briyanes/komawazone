#!/usr/bin/env node
/**
 * Batch import chapters for manga that have 0 chapters.
 *
 * The app uses lazy-loading for chapter images — images are fetched
 * from the source on first read. So we only need to create chapter
 * records with the chapter source_url. No image downloading needed!
 *
 * Usage:
 *   node scripts/import-chapters-batch.mjs                  # import all
 *   node scripts/import-chapters-batch.mjs --limit=10       # only 10 manga
 *   node scripts/import-chapters-batch.mjs --slug=xxx       # specific manga
 *   node scripts/import-chapters-batch.mjs --dry-run        # preview only
 */

import { readFileSync } from 'fs';
import { createClient } from '@supabase/supabase-js';
import { gotScraping } from 'got-scraping';
import path from 'path';
import { fileURLToPath } from 'url';

const __dirname = path.dirname(fileURLToPath(import.meta.url));

// ── Load .env.local ──────────────────────────────────────────────────────────
function loadEnv(filePath) {
  const content = readFileSync(filePath, 'utf-8');
  const env = {};
  for (const line of content.split('\n')) {
    const trimmed = line.trim();
    if (!trimmed || trimmed.startsWith('#') || trimmed.startsWith('//')) continue;
    const eqIdx = trimmed.indexOf('=');
    if (eqIdx === -1) continue;
    const key = trimmed.slice(0, eqIdx).trim();
    let val = trimmed.slice(eqIdx + 1).trim();
    if ((val.startsWith('"') && val.endsWith('"')) || (val.startsWith("'") && val.endsWith("'"))) {
      val = val.slice(1, -1);
    }
    env[key] = val;
  }
  return env;
}

const envPath = path.join(__dirname, '..', '.env.local');
const env = loadEnv(envPath);

// ── CLI args ─────────────────────────────────────────────────────────────────
const args = Object.fromEntries(
  process.argv.slice(2)
    .filter(a => a.startsWith('--'))
    .map(a => {
      const [k, v] = a.slice(2).split('=');
      return [k, v ?? true];
    })
);
const DRY_RUN = args['dry-run'] === true || args['dry-run'] === 'true';
const LIMIT = args['limit'] ? parseInt(args['limit']) : null;
const SLUG = args['slug'] || null;

// ── Clients ───────────────────────────────────────────────────────────────────
const supabase = createClient(env.NEXT_PUBLIC_SUPABASE_URL, env.SUPABASE_SERVICE_ROLE_KEY);

function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

// ── Chapter parsing ──────────────────────────────────────────────────────────
function parseChapterList(html) {
  const chapters = [];

  // eplister/chapterlist format
  const liRe = /<li[^>]+data-num="(\d+(?:\.\d+)?)"[^>]*>([\s\S]*?)<\/li>/gi;
  let m;
  while ((m = liRe.exec(html)) !== null) {
    const dataNum = parseFloat(m[1]);
    const block = m[2];
    const aMatch = block.match(/<a[^>]+href="([^"]+)"[^>]*>/i);
    const url = aMatch ? aMatch[1].trim() : '';
    const titleMatch = block.match(/<span[^>]+class="chapternum"[^>]*>([^<]+)/i);
    const title = titleMatch ? titleMatch[1].trim() : `Chapter ${dataNum}`;
    const dateRaw = block.match(/<span[^>]+class="chapterdate"[^>]*>([^<]+)/i)?.[1]?.trim() ?? null;

    let releasedAt = null;
    if (dateRaw) {
      const normalized = dateRaw
        .replace(/Januari/i, 'January').replace(/Februari/i, 'February')
        .replace(/Maret/i, 'March').replace(/Mei/i, 'May')
        .replace(/Juni/i, 'June').replace(/Juli/i, 'July')
        .replace(/Agustus/i, 'August').replace(/Oktober/i, 'October')
        .replace(/Desember/i, 'December');
      try { releasedAt = new Date(normalized).toISOString(); } catch { /* ignore */ }
    }

    chapters.push({ number: dataNum, title, url, releasedAt });
  }

  // Fallback: Madara wp-manga-chapter format
  if (chapters.length === 0) {
    const liRe2 = /<li[^>]+class="[^"]*wp-manga-chapter[^"]*"[^>]*>([\s\S]*?)<\/li>/gi;
    while ((m = liRe2.exec(html)) !== null) {
      const block = m[1];
      const aMatch = block.match(/<a[^>]+href="([^"]+)"[^>]*>\s*([\s\S]*?)\s*<\/a>/i);
      if (!aMatch) continue;
      const url = aMatch[1].trim();
      const rawTitle = aMatch[2].replace(/<[^>]+>/g, '').trim();
      const numFromUrl = url.match(/chapter[-_](\d+(?:\.\d+)?)/i);
      const numFromTitle = rawTitle.match(/chapter\s*(\d+(?:\.\d+)?)/i) ?? rawTitle.match(/^(\d+(?:\.\d+)?)/);
      const numStr = numFromUrl?.[1] ?? numFromTitle?.[1];
      if (!numStr) continue;
      chapters.push({ number: parseFloat(numStr), title: rawTitle, url, releasedAt: null });
    }
  }

  return chapters.sort((a, b) => a.number - b.number);
}

// ── Main ──────────────────────────────────────────────────────────────────────
async function main() {
  console.log('');
  console.log('📚  Batch Chapter Importer');
  console.log('══════════════════════════════════════');
  console.log(`   Mode: ${DRY_RUN ? 'DRY RUN' : 'LIVE'}`);
  if (LIMIT) console.log(`   Limit: ${LIMIT}`);
  if (SLUG) console.log(`   Slug: ${SLUG}`);
  console.log('');

  // 1. Get all manga IDs that already have chapters
  console.log('📥 Finding manga with chapters...');
  const mangaWithChapters = new Set();
  let cOff = 0;
  while (true) {
    const { data } = await supabase.from('chapters')
      .select('manga_id')
      .is('deleted_at', null)
      .range(cOff, cOff + 999);
    if (!data?.length) break;
    data.forEach(c => mangaWithChapters.add(c.manga_id));
    cOff += 1000;
  }
  console.log(`   ${mangaWithChapters.size} manga already have chapters`);

  // 2. Get all active manga without chapters
  console.log('📥 Finding manga without chapters...');
  const zeroChapterManga = [];
  let mOff = 0;
  while (true) {
    const { data } = await supabase.from('manga')
      .select('id, title, slug, source_url')
      .is('deleted_at', null)
      .not('source_url', 'is', null)
      .order('title')
      .range(mOff, mOff + 999);
    if (!data?.length) break;
    for (const m of data) {
      if (!mangaWithChapters.has(m.id)) {
        zeroChapterManga.push(m);
      }
    }
    mOff += 1000;
  }

  // Filter by slug if specified
  let toProcess = SLUG
    ? zeroChapterManga.filter(m => m.slug === SLUG)
    : zeroChapterManga;

  console.log(`   ${zeroChapterManga.length} manga with 0 chapters found`);
  if (LIMIT) {
    toProcess = toProcess.slice(0, LIMIT);
    console.log(`   Limited to: ${LIMIT}`);
  }
  console.log('');

  if (toProcess.length === 0) {
    console.log('Nothing to process!');
    return;
  }

  let totalChapters = 0;
  let mangaWithChaptersCreated = 0;
  let mangaFailed = 0;
  const BATCH = 3; // parallel requests per batch

  for (let i = 0; i < toProcess.length; i += BATCH) {
    const batch = toProcess.slice(i, i + BATCH);

    const results = await Promise.allSettled(batch.map(async (manga) => {
      try {
        // Fetch manga source page
        const response = await gotScraping({
          url: manga.source_url,
          responseType: 'text',
          timeout: { request: 20000 },
          retry: { limit: 0 },
          headerGeneratorOptions: {
            browsers: [{ name: 'chrome', minVersion: 112 }],
            devices: ['desktop'],
            operatingSystems: ['macos'],
          },
        });

        if (response.statusCode !== 200 || response.body.length < 2000) {
          return { manga, ok: false, reason: `HTTP ${response.statusCode}` };
        }

        const chapters = parseChapterList(response.body);
        if (chapters.length === 0) {
          return { manga, ok: false, reason: 'no chapters found' };
        }

        if (DRY_RUN) {
          return { manga, ok: true, chapterCount: chapters.length };
        }

        // Insert chapters into DB
        const chapterRows = chapters.map(ch => ({
          manga_id: manga.id,
          number: ch.number,
          title: ch.title,
          source_url: ch.url,
          released_at: ch.releasedAt,
          // thumbnail_url will be lazy-loaded when first read
        }));

        const { error } = await supabase.from('chapters').insert(chapterRows);
        if (error) {
          return { manga, ok: false, reason: `DB error: ${error.message}` };
        }

        return { manga, ok: true, chapterCount: chapters.length };
      } catch (err) {
        return { manga, ok: false, reason: err.message?.slice(0, 80) || 'unknown' };
      }
    }));

    for (const r of results) {
      const val = r.status === 'fulfilled' ? r.value : { ok: false, reason: r.reason?.message };
      if (val.ok) {
        mangaWithChaptersCreated++;
        totalChapters += val.chapterCount;
        console.log(`  ✅ ${val.manga.title.slice(0, 45).padEnd(45)} | ${val.chapterCount} chapters`);
      } else {
        mangaFailed++;
        const title = val.manga?.title?.slice(0, 35) || 'unknown';
        console.log(`  ❌ ${title.padEnd(35)} | ${val.reason}`);
      }
    }

    if ((i + BATCH) % 30 === 0 || i + BATCH >= toProcess.length) {
      const pct = ((i + BATCH) / toProcess.length * 100).toFixed(1);
      console.log(`\n  📊 [${i + BATCH}/${toProcess.length}] ${pct}% | ✅ ${mangaWithChaptersCreated} (${totalChapters} ch) | ❌ ${mangaFailed}\n`);
    }

    await sleep(1500 + Math.random() * 500);
  }

  console.log('');
  console.log('══════════════════════════════════════');
  console.log('📊  CHAPTER IMPORT SUMMARY');
  console.log('══════════════════════════════════════');
  console.log(`   Manga processed  : ${toProcess.length}`);
  console.log(`   Manga succeeded  : ${mangaWithChaptersCreated}`);
  console.log(`   Manga failed     : ${mangaFailed}`);
  console.log(`   Chapters created : ${totalChapters}`);
  if (DRY_RUN) console.log('\n   ⚠️  DRY RUN — nothing was actually changed.');
  console.log('');
}

main().catch(err => {
  console.error('Fatal error:', err);
  process.exit(1);
});