generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── USERS ────────────────────────────────────────────────────────────────

model User {
  id           String    @id @db.Uuid
  email        String    @unique
  username     String?   @unique
  avatarUrl    String?
  bio          String?
  role         UserRole  @default(USER)

  bookmarks       Bookmark[]
  likes           Like[]
  readingProgress ReadingProgress[]
  settings        UserSettings?
  uploadedManga   Manga[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@index([username])
  @@map("users")
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

model UserSettings {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  theme              String  @default("system")
  language           String  @default("en")
  nsfw               Boolean @default(false)
  emailNotifications Boolean @default(false)
  readerMode         String  @default("webtoon")
  readerWidth        String  @default("medium")

  @@map("user_settings")
}

// ─── MANGA ────────────────────────────────────────────────────────────────

model Manga {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String      @unique
  title       String
  description String?
  coverUrl    String?
  bannerUrl   String?
  status      MangaStatus @default(ONGOING)
  rating      Float       @default(0)
  ratingCount Int         @default(0)
  views       Int         @default(0)
  uploadedBy  String?     @db.Uuid
  uploader    User?       @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  chapters        Chapter[]
  bookmarks       Bookmark[]
  likes           Like[]
  readingProgress ReadingProgress[]
  genres          Genre[]           @relation("MangaGenre")
  authors         Author[]          @relation("MangaAuthor")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@index([status])
  @@index([createdAt])
  @@index([uploadedBy])
  @@map("manga")
}

enum MangaStatus {
  ONGOING
  COMPLETED
  HIATUS
  DROPPED
}

model Chapter {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mangaId     String    @db.Uuid
  manga       Manga     @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  number       Float
  title        String?
  thumbnailUrl String?   @map("thumbnail_url")
  releaseDate  DateTime  @default(now())
  views        Int       @default(0)

  images          ChapterImage[]
  readingProgress ReadingProgress[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([mangaId, number])
  @@index([mangaId])
  @@index([releaseDate])
  @@map("chapters")
}

model ChapterImage {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chapterId String @db.Uuid
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  number    Int
  imageUrl  String
  width     Int    @default(1080)
  height    Int    @default(1440)

  createdAt DateTime @default(now())

  @@unique([chapterId, number])
  @@index([chapterId])
  @@map("chapter_images")
}

// ─── USER INTERACTIONS ────────────────────────────────────────────────────

model Bookmark {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId  String @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  mangaId String @db.Uuid
  manga   Manga  @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, mangaId])
  @@index([userId])
  @@index([mangaId])
  @@map("bookmarks")
}

model Like {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId  String @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  mangaId String @db.Uuid
  manga   Manga  @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, mangaId])
  @@index([userId])
  @@index([mangaId])
  @@map("likes")
}

model ReadingProgress {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String  @db.Uuid
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mangaId         String  @db.Uuid
  manga           Manga   @relation(fields: [mangaId], references: [id], onDelete: Cascade)
  lastChapterId   String? @db.Uuid
  lastChapter     Chapter? @relation(fields: [lastChapterId], references: [id])
  lastPage        Int     @default(1)
  readPercentage  Int     @default(0)

  lastReadAt DateTime @default(now()) @updatedAt
  createdAt  DateTime @default(now())

  @@unique([userId, mangaId])
  @@index([userId])
  @@map("reading_progress")
}

// ─── CONTENT METADATA ────────────────────────────────────────────────────

model Genre {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String  @unique
  slug        String  @unique
  description String?

  manga Manga[] @relation("MangaGenre")

  @@map("genres")
}

model Author {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String  @unique
  slug      String  @unique
  biography String?

  manga Manga[] @relation("MangaAuthor")

  @@map("authors")
}

// ─── AD SYSTEM (4-table schema) ───────────────────────────────────────────

model AdProvider {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  type      AdProviderType
  isActive  Boolean         @default(true)
  pixelCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zones AdZone[]

  @@map("ad_providers")
}

model AdZone {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  placement   AdPlacement
  description String?
  isActive    Boolean     @default(true)

  providerId String     @db.Uuid
  provider   AdProvider @relation(fields: [providerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns AdCampaign[]

  @@index([placement])
  @@index([isActive])
  @@map("ad_zones")
}

model AdCampaign {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  zoneId      String  @db.Uuid
  zone        AdZone  @relation(fields: [zoneId], references: [id])
  type        AdType
  htmlContent String?
  imageUrl    String?
  linkUrl     String?
  isActive    Boolean @default(true)
  priority    Int     @default(0)
  startDate   DateTime?
  endDate     DateTime?
  targetMobile  Boolean @default(true)
  targetDesktop Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analytics AdAnalytics[]

  @@index([zoneId, isActive])
  @@index([priority])
  @@map("ad_campaigns")
}

model AdAnalytics {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId String   @db.Uuid
  campaign   AdCampaign @relation(fields: [campaignId], references: [id])
  event      AdEvent
  userId     String?  @db.Uuid
  ipHash     String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([campaignId, event])
  @@index([createdAt])
  @@map("ad_analytics")
}

enum AdProviderType {
  ADSTERRA
  CUSTOM_HTML
  PIXEL_ONLY
  GOOGLE_ADSENSE
}

enum AdType {
  BANNER
  PIXEL
  CUSTOM_HTML
  NATIVE
}

enum AdPlacement {
  HOME_TOP
  HOME_BOTTOM
  READER_TOP
  READER_BOTTOM
  SIDEBAR
  SEARCH_RESULTS
  CHAPTER_BETWEEN_PAGES
}

enum AdEvent {
  IMPRESSION
  CLICK
}

// ─── AUDIT LOG ────────────────────────────────────────────────────────────

model AuditLog {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String? @db.Uuid
  action     String
  resource   String
  resourceId String
  changes    Json?
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}
