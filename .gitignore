# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Script progress & log files
scripts/.r2-migrate-progress.json
scripts/.chapter-download-progress.json
scripts/.import-progress.json
scripts/.fix-dead-images-progress.json
scripts/failed-covers.jsonl
scripts/failed-chapters.jsonl
scripts/failed-null-thumbnails.jsonl
scripts/failed-gmbr-fix.jsonl
scripts/fix-dead-images-failures.jsonl
scripts/*.log
scripts/*-progress.json

# Root-level logs, progress, and audit artifacts
/*.log
/*-log.txt
/*-log-*.txt
/audit-*.json
/audit-*.log
/backfill-*.json
/backfill-*.log
/gif-thumb-fix-progress.json
/thumbnail-backfill-log.txt

# Proxy & credentials (NEVER commit)
docs/Webshare*.txt
docs/listproxcy
docs/*proxies*

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# supabase temp
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts
